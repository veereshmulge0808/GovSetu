# =============================================================================
# GovSetu Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_NAME="GovSetu API"
APP_VERSION=1.0.0

# --- Database ---
DATABASE_URL="postgresql://govsetu:govsetu_pass@localhost:5432/govsetu_db?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# --- Object Storage (MinIO / S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=govsetu-documents
STORAGE_REGION=us-east-1

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="GovSetu <noreply@govsetu.gov.in>"

# --- Throttling (Rate Limiting) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE="GovSetu API"
SWAGGER_DESCRIPTION="AI-Powered Government Innovation Procurement Platform — Backend API"
SWAGGER_VERSION=1.0

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Logging ---
LOG_LEVEL=debug
